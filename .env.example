# Grafana + Traefik + Let's Encrypt — Environment Variables
# Copy this file to `.env` and fill in each value before `docker compose up`.
# `.env` is gitignored — never commit real credential values.
#
# Image versions are NOT set here. The tested tag + sha256 digest for every
# image lives in the compose file's `x-images` block, so `git pull` delivers
# the version combination this repository has tested without touching your
# .env. To pin a different version yourself, uncomment and set:
# TRAEFIK_IMAGE_TAG=traefik:3.7@sha256:…
# GRAFANA_POSTGRES_IMAGE_TAG=postgres:17-alpine@sha256:…
# GRAFANA_IMAGE_TAG=grafana/grafana:13.2.0@sha256:…

# ──────────────────────────────────────────────────────────────────────────────
# Traefik reverse proxy
# ──────────────────────────────────────────────────────────────────────────────

# Email address for Let's Encrypt renewal notices. REQUIRED.
TRAEFIK_ACME_EMAIL=admin@example.com

# Hostname for the Traefik dashboard (basic-auth protected). REQUIRED.
TRAEFIK_HOSTNAME=traefik.grafana.example.com

# Basic Authentication for the Traefik dashboard.
# Format: USERNAME:BCRYPT_HASH (with $ characters doubled to $$ for compose)
#
# Generate a new BCrypt hash (replace YOUR_STRONG_PASSWORD):
#     htpasswd -nbB traefikadmin YOUR_STRONG_PASSWORD | sed 's/\$/\$\$/g'
#
# Or using docker without installing apache2-utils:
#     docker run --rm httpd:2.4 htpasswd -nbB traefikadmin YOUR_STRONG_PASSWORD | sed 's/\$/\$\$/g'
#
# REQUIRED — do not ship production without changing this.
TRAEFIK_BASIC_AUTH=change_me_generate_with_htpasswd_and_replace_this_string

# Log level: DEBUG, INFO, WARN, ERROR. Default: WARN.
# TRAEFIK_LOG_LEVEL=WARN

# ──────────────────────────────────────────────────────────────────────────────
# Grafana
# ──────────────────────────────────────────────────────────────────────────────

# Public hostname and full URL for Grafana. The hostname must resolve to
# this server's public IP for the Let's Encrypt TLS-ALPN challenge. REQUIRED.
GRAFANA_HOSTNAME=grafana.example.com
GRAFANA_URL=https://grafana.example.com

# REQUIRED — generate each with:
#     openssl rand -base64 24 | tr -d '/+=' | head -c 32
GRAFANA_DB_PASSWORD=change_me_before_first_start
GRAFANA_ADMIN_PASSWORD=change_me_before_first_start

# Defaults below are set in the compose file; override only to diverge.
# GRAFANA_DB_NAME=grafanadb
# GRAFANA_DB_USER=grafanadbuser
# GRAFANA_ADMIN_USERNAME=grafanaadmin
# GRAFANA_USERS_ALLOW_SIGN_UP=false
# GRAFANA_AUTH_ANONYMOUS_ENABLED=false
# GRAFANA_PLUGINS_INSTALL=alexanderzobnin-zabbix-app

# ──────────────────────────────────────────────────────────────────────────────
# SMTP for email alerts (disabled by default)
# ──────────────────────────────────────────────────────────────────────────────

# GRAFANA_SMTP_ENABLED=true
# GRAFANA_SMTP_ADDRESS=smtp.example.com
# GRAFANA_SMTP_PORT=587
# GRAFANA_SMTP_USER_NAME=grafana@example.com
# GRAFANA_SMTP_PASSWORD=change_me
# GRAFANA_SMTP_NAME_FROM=Grafana Alert
# GRAFANA_EMAIL_FROM=grafana@example.com

# ──────────────────────────────────────────────────────────────────────────────
# Backups (defaults shown; override only to tune)
# ──────────────────────────────────────────────────────────────────────────────

# BACKUP_INIT_SLEEP=30m
# BACKUP_INTERVAL=24h
# POSTGRES_BACKUP_PRUNE_DAYS=7
# DATA_BACKUP_PRUNE_DAYS=7
# POSTGRES_BACKUPS_PATH=/srv/grafana-postgres/backups
# DATA_BACKUPS_PATH=/srv/grafana-application-data/backups
# DATA_PATH=/var/lib/grafana
# POSTGRES_BACKUP_NAME=grafana-postgres-backup
# DATA_BACKUP_NAME=grafana-application-data-backup
